{
  "root": "build",
  "clean_urls": false,
  "routes": [
    { "src": "/assets/(.*)", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|webp|woff2?))", "continue": true },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
